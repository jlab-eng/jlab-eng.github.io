<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div>

        {% if entry.studyType %}
          <h6 class="title font-weight-bold">
            {{ entry.studyType }}
          </h6>
        {% endif %}

        {% if entry.institution %}
          <h6 style="font-size: 0.95rem">
            {{ entry.institution }}
          </h6>
        {% endif %}

        {% if entry.area %}
          <h6 style="font-size: 0.95rem; font-style: italic">
            {{ entry.area }}
          </h6>
        {% endif %}

        {% if entry.location or entry.end_date %}
          <p style="font-size: 0.85rem; opacity: 0.70; margin-bottom: 0.6rem;">

            {% if entry.location %}
              {{ entry.location }}
            {% endif %}

            {% if entry.location and entry.end_date %}
              ·
            {% endif %}

            {% if entry.end_date %}
              Expected {{ entry.end_date | split: '-' | first }}
            {% endif %}

          </p>
        {% endif %}

        {% if entry.highlights %}
          <ul class="items">
            {% for item in entry.highlights %}
              <li>
                <span class="item">
                  {{ item | markdownify | remove: '<p>' | remove: '</p>' }}
                </span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

      </div>
    </li>
  {% endfor %}
</ul>
